[Unit]
Description=CoreCart (gunicorn)
After=network-online.target postgresql.service __REDIS__.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=corecart
Group=corecart
EnvironmentFile=/etc/corecart/env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/corecart/current
ExecStart=/opt/corecart/current/.venv/bin/gunicorn config.wsgi -c /opt/corecart/current/gunicorn.conf.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=35
MemoryMax=600M

# Sandboxing: the app can write only its data directory.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/corecart
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
