# Included by nginx.conf for requests proxied to gunicorn.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
# CloudFront adds the viewer IP to X-Forwarded-For, nginx adds CloudFront's: DJANGO_NUM_PROXIES=2.
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# CloudFront redirects HTTP to HTTPS, so every request that reaches us was HTTPS at the edge.
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Origin-Verify "";
proxy_redirect off;
proxy_read_timeout 35s;
