# Copy to .env for local development. Never commit real credentials.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production when served over HTTPS on a custom domain, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
CORECART_BASE_URL=http://localhost:8000
DJANGO_TIME_ZONE=UTC

# --- Database ---------------------------------------------------------------
# sqlite (default) or postgresql
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3
# DB_NAME=corecart
# DB_USER=corecart
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Email ------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CoreCart <noreply@corecart.local>

# --- Production security (only used when DJANGO_DEBUG=False) -----------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_BEHIND_PROXY=False
# DJANGO_STATIC_ROOT=/var/www/corecart/static
# DJANGO_MEDIA_ROOT=/var/www/corecart/media

# --- REST API ---------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
API_THROTTLE_ANON=120/min
API_THROTTLE_USER=1200/min
API_THROTTLE_AUTH=20/min
# Public URL of a separate frontend app (used in password-reset email links)
CORECART_FRONTEND_URL=
# Browser frontend origins allowed to call the API (comma separated).
# Defaults to http://localhost:5173,http://localhost:3000 when DEBUG is on.
CORS_ALLOWED_ORIGINS=
# httpOnly refresh-token cookie (used when a client logs in with "use_cookie": true)
# JWT_REFRESH_COOKIE_SAMESITE=Lax
# JWT_REFRESH_COOKIE_DOMAIN=.example.com

# --- Production infrastructure (requires `uv sync --extra production`) --------
# Shared cache for rate limiting across workers
# REDIS_URL=redis://localhost:6379/0
# Media storage: local (default) or s3 (AWS S3, Cloudflare R2, MinIO...)
# MEDIA_STORAGE=s3
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_CUSTOM_DOMAIN=cdn.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Move the Django admin away from /admin/
# DJANGO_ADMIN_URL=ops-change-me/
# GUNICORN_WORKERS=5

# --- Marketplace ------------------------------------------------------------
CORECART_PAYMENT_METHODS=cod,bank_transfer
CORECART_CURRENCY_SYMBOL=$
# Maximum image upload size in bytes (default 2 MB)
CORECART_MAX_IMAGE_SIZE=2097152
