# Copy to .env for local development. Never commit real credentials.

# --- Core -------------------------------------------------------------------
DJANGO_DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production when served over HTTPS on a custom domain, e.g. https://shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
CORECART_BASE_URL=http://localhost:8000
DJANGO_TIME_ZONE=UTC

# --- Database ---------------------------------------------------------------
# sqlite (default) or postgresql
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3
# DB_NAME=corecart
# DB_USER=corecart
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Email ------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CoreCart <noreply@corecart.local>

# --- Production security (only used when DJANGO_DEBUG=False) -----------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_BEHIND_PROXY=False
# DJANGO_STATIC_ROOT=/var/www/corecart/static
# DJANGO_MEDIA_ROOT=/var/www/corecart/media

# --- Marketplace ------------------------------------------------------------
CORECART_PAYMENT_METHODS=cod,bank_transfer
CORECART_CURRENCY_SYMBOL=$
# Maximum image upload size in bytes (default 2 MB)
CORECART_MAX_IMAGE_SIZE=2097152
